<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.skaria.ecommerce</groupId>
    <artifactId>ecommerce-contracts</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>ecommerce-custom-annotations</module>
        <module>product</module>
        <module>ecommerce-contract-bom</module>
        <module>ecommerce-contract-model-parent</module>
        <module>ecommerce-contract-api-parent</module>

    </modules>

    <properties>
        <target.java.version>25</target.java.version>
        <maven.compiler.source>${target.java.version}</maven.compiler.source>
        <maven.compiler.target>${target.java.version}</maven.compiler.target>
        <maven.compiler.release>${target.java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Core Serialization & Model Tools -->
        <avro.version>1.12.1</avro.version>
        <lombok.version>1.18.48</lombok.version>
        <json.schema.version>1.2.1</json.schema.version>
        <jackson.version>2.22</jackson.version>
        <confluent.version>8.3.1</confluent.version>
        <openapi.processor.version>2026.1</openapi.processor.version>
        <build.helper.version>3.6.1</build.helper.version>
        <commons-io.version>1.3.2</commons-io.version>
        <jakarta.validation-api.version>3.1.1</jakarta.validation-api.version>

        <!-- Logging & Testing -->
        <slf4j.version>2.0.16</slf4j.version>
        <junit.version>5.11.4</junit.version>
        <assertj-core.version>3.27.3</assertj-core.version>

        <!-- Maven Plugins -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
        <maven.deploy.skip>false</maven.deploy.skip>
        <inclusionLevel>NON_NULL</inclusionLevel>
        <enable>false</enable>

        <!-- open api plugins-->
        <openapi-generator-maven-plugin.version>7.8.0</openapi-generator-maven-plugin.version>

        <!-- -->
        <spring-web.version>6.2.3</spring-web.version>
    </properties>

    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

