                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build.helper.version}</version>

                    <executions>
                        <execution>
                            <id>add-openapi-generated-sources</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>add-source</goal>
                            </goals>

                            <configuration>
                                <sources>
                                    <source>
                                        ${project.build.directory}/generated-sources/openapi
                                    </source>
                                </sources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jsonschema2pojo</groupId>
                    <artifactId>jsonschema2pojo-maven-plugin</artifactId>
                    <version>${json.schema.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.example</groupId>
                            <artifactId>custom-annotations</artifactId>
                            <version>${project.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>json</id>
                            <configuration>
                                <sourceDirectory>${project.basedir}/src/main/resources/schema/json</sourceDirectory>
                                <outputDirectory>${project.build.directory}/generated-sources</outputDirectory>
                                <targetPackage>com.skaria.json.model</targetPackage>
                                <includeGetters>${enable}</includeGetters>
                                <includeSetters>${enable}</includeSetters>
                                <includeToString>${enable}</includeToString>
                                <inclusionLevel>${inclusionLevel}</inclusionLevel>
                                <includeHashcodeAndEquals>${enable}</includeHashcodeAndEquals>
                                <customAnnotator>org.example.LombokAnnotator</customAnnotator>
                                <includeJsr303Annotations>true</includeJsr303Annotations>
                                <includeAdditionalProperties>false</includeAdditionalProperties>
                            </configuration>
                            <goals>
                                <goal>generate</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
